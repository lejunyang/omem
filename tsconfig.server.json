{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "apps/server/src/**/*.ts",
    "packages/contracts/src/**/*.ts",
    "scripts/dev.ts",
    "scripts/dev-review.ts",
    "scripts/dev-review-vite.ts",
    "scripts/review-wiki.ts",
    "scripts/review-knowledge.ts",
    "scripts/review-verify.ts",
    "scripts/retrieval-index.ts",
    "scripts/live-retrieval-smoke.ts",
    "scripts/review-guides.ts"
  ]
}
