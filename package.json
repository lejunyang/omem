{
  "name": "omem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:web": "pnpm --filter @omem/web run dev",
    "dev:review": "tsx scripts/dev-review.ts",
    "build": "tsc -p tsconfig.server.json && pnpm --filter @omem/web run build",
    "start": "node dist/apps/server/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && vue-tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "test:live-role": "tsx scripts/live-role-smoke.ts",
    "test:live-learning": "tsx scripts/live-learning-smoke.ts",
    "test:live-pipeline": "tsx scripts/live-pipeline-smoke.ts",
    "test:live-lark-host": "tsx scripts/live-lark-host-smoke.ts",
    "quality:lark-annotate": "tsx scripts/quality-lark-annotate.ts",
    "quality:evaluate": "tsx scripts/quality-evaluate.ts",
    "quality:run": "tsx scripts/quality-run.ts",
    "cli": "tsx apps/server/src/cli.ts",
    "format": "prettier --write \"apps/**/*.{ts,vue,css,mjs}\" \"packages/**/*.{ts,vue,css}\" \"scripts/*.ts\""
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@fastify/static": "8.3.0",
    "@larksuiteoapi/node-sdk": "1.74.0",
    "fastify": "5.12.5",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/compiler-sfc": "3.5.43",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "3.2.4",
    "vue-tsc": "3.1.4"
  }
}
