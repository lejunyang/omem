{
  "name": "omem",
  "version": "0.2.0",
  "description": "Personal memory and assistant: understand materials, find answers with evidence, follow up and delegate work to agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "omem": "dist/src/cli.js"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --watch src/cli.ts serve",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "start": "node dist/src/cli.js serve",
    "cli": "node src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "eval:retrieval": "node scripts/eval-retrieval.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "8.3.0",
    "@inquirer/prompts": "8.7.3",
    "@larksuite/cli": "1.0.97",
    "@larksuiteoapi/node-sdk": "1.74.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "commander": "15.0.0",
    "croner": "10.0.0",
    "fastify": "5.12.5",
    "ts-fsrs": "5.4.2",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.1.12"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "3.8.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "6.0.9",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "marked": "18.0.14",
    "mermaid": "11.17.2",
    "playwright": "^1.58.2",
    "vite": "7.3.1",
    "vitest": "3.2.4",
    "vue": "3.5.43",
    "vue-router": "4.6.4",
    "vue-tsc": "3.1.4",
    "ws": "^8.18.3"
  },
  "files": [
    "dist/src/**/*.js",
    "web/dist",
    "roles",
    "scripts/document-parser/convert.py",
    "scripts/document-parser/pyproject.toml",
    "scripts/document-parser/uv.lock",
    "skills",
    ".agents/skills/lieflat-less-ai-tone",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lejunyang/omem.git"
  }
}
