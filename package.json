{
  "name": "omem",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "nodemon --config nodemon.json apps/server/src/main.ts",
    "dev:web": "pnpm --filter @omem/web run dev",
    "build": "tsc -p tsconfig.server.json && pnpm --filter @omem/web run build",
    "start": "node dist/apps/server/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && vue-tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:browser": "bun scripts/browser-smoke.ts",
    "test:live-role": "bun scripts/live-role-smoke.ts",
    "test:live-learning": "bun scripts/live-learning-smoke.ts",
    "test:live-pipeline": "bun scripts/live-pipeline-smoke.ts",
    "test:live-lark-host": "bun scripts/live-lark-host-smoke.ts",
    "quality:lark-annotate": "bun scripts/quality-lark-annotate.ts",
    "quality:evaluate": "bun scripts/quality-evaluate.ts",
    "quality:run": "bun scripts/quality-run.ts",
    "cli": "bun apps/server/src/cli.ts",
    "format": "prettier --write \"apps/**/*.{ts,vue,css,mjs}\" \"packages/**/*.{ts,vue,css}\" \"scripts/*.ts\"",
    "prepack": "node scripts/package-check.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@fastify/static": "8.3.0",
    "@huggingface/transformers": "3.8.1",
    "@larksuite/cli": "1.0.97",
    "@larksuiteoapi/node-sdk": "1.74.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@vue/compiler-sfc": "3.5.43",
    "commander": "15.0.0",
    "diff": "9.0.0",
    "fastify": "5.12.5",
    "marked": "18.0.14",
    "pm2": "7.0.4",
    "typescript": "5.9.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.9",
    "hyparquet": "1.31.2",
    "nodemon": "3.1.14",
    "prettier": "3.6.2",
    "vite": "7.3.1",
    "vitest": "3.2.4",
    "vue-tsc": "3.1.4"
  },
  "description": "Personal memory and assistant: capture, retrieve, understand and follow up.",
  "license": "Apache-2.0",
  "bin": {
    "omem": "dist/apps/server/src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lejunyang/omem.git"
  },
  "homepage": "https://github.com/lejunyang/omem#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/apps/server/src/**/*.js",
    "dist/packages/**/*.js",
    "dist/scripts/document-prepare.js",
    "dist/scripts/document-models.js",
    "dist/scripts/startlux-prepare.js",
    "apps/web/dist",
    "packages/agent-runtime/roles",
    "config/omem.default.json",
    "config/models.toml",
    "scripts/document-parser/convert.py",
    "scripts/document-parser/pyproject.toml",
    "scripts/document-parser/uv.lock",
    "scripts/startlux/worker.py",
    "scripts/startlux/pyproject.toml",
    "scripts/startlux/uv.lock",
    "scripts/startlux/upstream.json",
    "scripts/package-check.mjs",
    "skills",
    ".agents/skills/lieflat-less-ai-tone",
    "docs/cli.md",
    "LICENSE",
    "docs/reader-first/data-lifecycle.md",
    "docs/reader-first/requirement-followup.md",
    "docs/reader-first/assistant-orchestration.md",
    "docs/reader-first/agent-providers.md"
  ]
}
