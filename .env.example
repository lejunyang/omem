# omem-local encryption key, not the Feishu App Secret.
# Generate once with: openssl rand -base64 32
# Keep the same value across restarts and store it in a password manager or
# service secret. Losing or rotating it makes existing .omem/secrets/*.json
# unreadable; re-authorize/import each Lark app after an intentional rotation.
OMEM_SECRET_KEY=
