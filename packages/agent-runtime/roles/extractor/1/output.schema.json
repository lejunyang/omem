{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omem.invalid/contracts/ProposalBatch.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "role_id",
    "observations",
    "proposals",
    "abstentions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "role_id": { "const": "extractor" },
    "observations": { "type": "array" },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "proposal_id",
          "kind",
          "operation",
          "scope",
          "body",
          "evidence",
          "uncertainties",
          "reason",
          "expected_versions",
          "origin"
        ],
        "properties": {
          "schema_version": { "const": 1 },
          "proposal_id": { "type": "string" },
          "kind": { "enum": ["task", "claim", "episode", "procedure"] },
          "operation": { "enum": ["create", "update", "supersede"] },
          "scope": { "type": "object" },
          "body": { "type": "object" },
          "evidence": { "type": "array", "minItems": 1 },
          "uncertainties": { "type": "array" },
          "reason": { "type": "string" },
          "expected_versions": { "type": "object" },
          "origin": { "type": "object" },
          "target_id": { "type": ["string", "null"] }
        }
      }
    },
    "abstentions": { "type": "array" }
  }
}
