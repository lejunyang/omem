{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "execute",
        "decline",
        "uncertain"
      ]
    },
    "instruction": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "targetBasis": {
      "type": "string",
      "enum": [
        "current_request",
        "prior_turn",
        "active_project",
        "unresolved"
      ]
    },
    "targetQuote": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": [
    "verdict",
    "instruction",
    "targetBasis",
    "targetQuote",
    "reason"
  ],
  "additionalProperties": false,
  "$id": "RequestInterpretation.v1"
}
