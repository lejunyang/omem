{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "documents": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement": {
            "type": "object",
            "properties": {
              "objective": {
                "type": "string",
                "minLength": 1
              },
              "nonGoals": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "criteria": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "missing",
                        "implemented",
                        "verified",
                        "released",
                        "uncertain"
                      ]
                    },
                    "evidence": {
                      "description": "Keys of original-material citations in this document",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "description",
                    "status",
                    "evidence"
                  ],
                  "additionalProperties": false
                }
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "detail": {
                      "type": "string"
                    },
                    "owner": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "waitingOn": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "dueAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "dueExpression": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "open",
                        "waiting",
                        "done",
                        "cancelled"
                      ]
                    },
                    "certainty": {
                      "type": "string",
                      "enum": [
                        "confirmed",
                        "proposed",
                        "uncertain"
                      ]
                    },
                    "evidence": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "detail",
                    "owner",
                    "waitingOn",
                    "dueAt",
                    "dueExpression",
                    "status",
                    "certainty",
                    "evidence"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "objective",
              "nonGoals",
              "criteria",
              "actions"
            ],
            "additionalProperties": false
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "topicPath": {
            "description": "Human topic hierarchy, broad to specific. Organize by the subject and reader purpose, not source directories or internal ids.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "sections": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,59}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24000
                },
                "reviewSources": {
                  "description": "Background premises whose change requires reviewing this section, even when not cited in its prose. Select the relevant original range and explain the premise. Do not list everything read.",
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "startLine": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "endLine": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 800
                      }
                    },
                    "required": [
                      "key",
                      "startLine",
                      "endLine",
                      "reason"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "key",
                "title",
                "body"
              ],
              "additionalProperties": false
            }
          },
          "citations": {
            "minItems": 1,
            "maxItems": 160,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,39}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 800
                },
                "relation": {
                  "type": "string",
                  "enum": [
                    "supports",
                    "explains",
                    "implements",
                    "depends_on",
                    "calls",
                    "contradicts",
                    "background",
                    "tracks"
                  ]
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "material",
                        "article"
                      ]
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "startLine": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "section": {
                      "type": "string",
                      "maxLength": 100
                    }
                  },
                  "required": [
                    "kind",
                    "key"
                  ],
                  "additionalProperties": false
                },
                "quote": {
                  "description": "Leave empty. The host extracts the exact quote from the selected fixed line range before independent review.",
                  "default": "",
                  "type": "string",
                  "maxLength": 120000
                }
              },
              "required": [
                "key",
                "label",
                "reason",
                "relation",
                "target",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "questions": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "description": "investigate: agent must search/read actual state; supplement: useful nonblocking detail; decision: a real owner choice affecting present scope, responsibility or permission. Only decision may be blocking. Missing legacy classification is investigate, never an automatic request for owner approval.",
                  "type": "string",
                  "enum": [
                    "investigate",
                    "supplement",
                    "decision"
                  ]
                },
                "question": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "why": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "nextStep": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "blocking": {
                  "type": "boolean"
                },
                "citationKeys": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "question",
                "why",
                "nextStep",
                "blocking",
                "citationKeys"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "key",
          "title",
          "summary",
          "category",
          "sections",
          "citations",
          "questions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "documents"
  ],
  "additionalProperties": false,
  "$id": "https://omem.invalid/contracts/KnowledgeBatch.v1"
}
