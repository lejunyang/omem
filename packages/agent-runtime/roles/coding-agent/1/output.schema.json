{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "implemented",
              "blocked"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "summary",
    "criteria",
    "blockers"
  ],
  "additionalProperties": false,
  "$id": "ImplementationResult.v1"
}
