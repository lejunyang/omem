{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "role_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "assessments": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proposal_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "proposal_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "quote_asset_verdict": {
            "type": "string",
            "enum": [
              "valid",
              "invalid",
              "ambiguous"
            ]
          },
          "semantic_verdict": {
            "type": "string",
            "enum": [
              "supported",
              "contradicted",
              "insufficient",
              "needs_scope"
            ]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "missing_context": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "required": [
          "proposal_id",
          "proposal_digest",
          "quote_asset_verdict",
          "semantic_verdict",
          "reason_code",
          "reason",
          "missing_context"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "role_id",
    "assessments"
  ],
  "additionalProperties": false,
  "$id": "https://omem.invalid/contracts/AssessmentBatch.v1"
}
