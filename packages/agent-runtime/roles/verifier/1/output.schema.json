{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omem.invalid/contracts/AssessmentBatch.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "role_id", "assessments"],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "role_id": { "const": "verifier" },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "proposal_digest",
          "quote_asset_verdict",
          "semantic_verdict",
          "reason_code",
          "reason",
          "missing_context"
        ],
        "properties": {
          "proposal_id": { "type": "string" },
          "proposal_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "quote_asset_verdict": { "enum": ["valid", "invalid", "ambiguous"] },
          "semantic_verdict": {
            "enum": ["supported", "contradicted", "insufficient", "needs_scope"]
          },
          "reason_code": { "type": "string" },
          "reason": { "type": "string" },
          "missing_context": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
