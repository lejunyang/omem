{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "project_selection": {
      "description": "The project this conversation is now about, chosen from the supplied saved projects. Resolve from the current question, prior clarification and material context, not a similar name alone. Null clears the project for unrelated/general questions, comparisons or unresolved ambiguity. This is a reading scope, not permission or a fact update.",
      "type": "object",
      "properties": {
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "work_action": {
      "description": "Explicit current-user requirement tracking, feedback or implementation delegation. Use work_catalog/work_status before selecting saved identities. Host applies it after the turn, never claim success in advance. Null in research mode; do not also create an ordinary task.",
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "configure_project"
                },
                "project": {
                  "type": "string",
                  "minLength": 1
                },
                "configuration": {
                  "type": "object",
                  "properties": {
                    "expectedVersion": {
                      "description": "Current configurationVersion returned by project_inspect.",
                      "type": "string",
                      "minLength": 1
                    },
                    "instructions": {
                      "description": "Project-specific implementation and acceptance instructions, preserving existing owner constraints.",
                      "type": "string"
                    },
                    "ruleFiles": {
                      "description": "Additional repository-relative instructions; AGENTS.md and CLAUDE.md are already read automatically.",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "commands": {
                      "description": "Full replacement command list. Derive executable/args/cwd from actual project docs and manifests. No publish, push, remote writes or global installation.",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
                          },
                          "command": {
                            "type": "string",
                            "minLength": 1
                          },
                          "args": {
                            "default": [],
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "cwd": {
                            "default": ".",
                            "type": "string"
                          },
                          "purpose": {
                            "type": "string",
                            "enum": [
                              "setup",
                              "test",
                              "build",
                              "browser",
                              "design"
                            ]
                          },
                          "required": {
                            "default": true,
                            "type": "boolean"
                          },
                          "timeoutMs": {
                            "default": 600000,
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "name",
                          "command",
                          "args",
                          "cwd",
                          "purpose",
                          "required",
                          "timeoutMs"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "sources": {
                      "description": "Actual paths and hashes returned by project_read or project_inspect; include applicable rules and the command definitions.",
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "hash": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "path",
                          "hash"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "summary": {
                      "description": "Briefly explain the chosen setup and checks in user language.",
                      "type": "string",
                      "minLength": 1
                    },
                    "gaps": {
                      "description": "Missing environment, credentials or acceptance steps. Saving configuration does not mean commands succeeded.",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "expectedVersion",
                    "instructions",
                    "ruleFiles",
                    "commands",
                    "sources",
                    "summary",
                    "gaps"
                  ],
                  "additionalProperties": false
                },
                "delegation": {
                  "description": "Exact current owner request to prepare/configure this project's development checks. Saves configuration only; does not execute commands.",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "operation",
                "project",
                "configuration",
                "delegation"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "prepare_repository"
                },
                "alias": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
                },
                "url": {
                  "description": "Exact Git address/path supplied by the owner, or the origin of an already registered project. No credentials in URLs.",
                  "type": "string",
                  "minLength": 1
                },
                "ref": {
                  "description": "Requested branch, tag or commit; use HEAD only when no version was specified. Preserve a registered project's ref when retrying.",
                  "type": "string",
                  "minLength": 1
                },
                "delegation": {
                  "description": "Copy the current owner request to prepare, fetch or retry this repository. This queues preparation, not coding.",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "operation",
                "alias",
                "url",
                "ref",
                "delegation"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "track"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "goal": {
                  "type": "string",
                  "minLength": 1
                },
                "contextIds": {
                  "description": "Prefer the saved project/topic when asked to continuously follow that project; this includes future members. Use returned IDs.",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "materialKeys": {
                  "description": "Specific originals only. An empty list with contextIds follows all members of the selected project.",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "attention": {
                  "type": "object",
                  "properties": {
                    "focus": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "ignore": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "notifications": {
                      "default": "important",
                      "type": "string",
                      "enum": [
                        "important",
                        "all"
                      ]
                    },
                    "instruction": {
                      "description": "Host-preserved owner wording. The host replaces this with the current user's actual request when preferences are set.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "focus",
                    "ignore",
                    "notifications"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "operation",
                "title",
                "goal",
                "contextIds",
                "materialKeys",
                "attention"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "feedback"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "expectedVersion": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "correction",
                    "attention"
                  ]
                },
                "text": {
                  "description": "Exact relevant words from the current user message, not paraphrased source text.",
                  "type": "string",
                  "minLength": 1
                },
                "attention": {
                  "type": "object",
                  "properties": {
                    "focus": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "ignore": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "notifications": {
                      "default": "important",
                      "type": "string",
                      "enum": [
                        "important",
                        "all"
                      ]
                    },
                    "instruction": {
                      "description": "Host-preserved owner wording. The host replaces this with the current user's actual request when preferences are set.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "focus",
                    "ignore",
                    "notifications"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "operation",
                "key",
                "expectedVersion",
                "kind",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "revoke_feedback"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "expectedVersion": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "feedbackId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "operation",
                "key",
                "expectedVersion",
                "feedbackId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "scope"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "expectedVersion": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "contextIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "materialKeys": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "operation",
                "key",
                "expectedVersion",
                "contextIds",
                "materialKeys"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "enum": [
                    "pause",
                    "resume",
                    "refresh"
                  ]
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "expectedVersion": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "operation",
                "key",
                "expectedVersion"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "start_development"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "project": {
                  "type": "string",
                  "minLength": 1
                },
                "configuration": {
                  "description": "Optional explicit project configuration. Normally dispatch the assignment directly: the coding agent reads repository rules and chooses missing/outdated checks in its own checkout.",
                  "type": "object",
                  "properties": {
                    "expectedVersion": {
                      "description": "Current configurationVersion returned by project_inspect.",
                      "type": "string",
                      "minLength": 1
                    },
                    "instructions": {
                      "description": "Project-specific implementation and acceptance instructions, preserving existing owner constraints.",
                      "type": "string"
                    },
                    "ruleFiles": {
                      "description": "Additional repository-relative instructions; AGENTS.md and CLAUDE.md are already read automatically.",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "commands": {
                      "description": "Full replacement command list. Derive executable/args/cwd from actual project docs and manifests. No publish, push, remote writes or global installation.",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
                          },
                          "command": {
                            "type": "string",
                            "minLength": 1
                          },
                          "args": {
                            "default": [],
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "cwd": {
                            "default": ".",
                            "type": "string"
                          },
                          "purpose": {
                            "type": "string",
                            "enum": [
                              "setup",
                              "test",
                              "build",
                              "browser",
                              "design"
                            ]
                          },
                          "required": {
                            "default": true,
                            "type": "boolean"
                          },
                          "timeoutMs": {
                            "default": 600000,
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "name",
                          "command",
                          "args",
                          "cwd",
                          "purpose",
                          "required",
                          "timeoutMs"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "sources": {
                      "description": "Actual paths and hashes returned by project_read or project_inspect; include applicable rules and the command definitions.",
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "hash": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "path",
                          "hash"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "summary": {
                      "description": "Briefly explain the chosen setup and checks in user language.",
                      "type": "string",
                      "minLength": 1
                    },
                    "gaps": {
                      "description": "Missing environment, credentials or acceptance steps. Saving configuration does not mean commands succeeded.",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "expectedVersion",
                    "instructions",
                    "ruleFiles",
                    "commands",
                    "sources",
                    "summary",
                    "gaps"
                  ],
                  "additionalProperties": false
                },
                "inputReceipts": {
                  "description": "Relevant actual external receipt IDs returned by conversation_inputs or capability_call. Empty means none; omitted carries up to 100 recent receipts for selected capabilities. No arbitrary paths or invented source content.",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "capabilities": {
                  "description": "Optional subset of registered read-only capabilities for this coding task; omitted uses project defaults.",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "delegation": {
                  "description": "Copy the CURRENT user's explicit implementation assignment. Reading a source or asking how implementation works is not delegation.",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "operation",
                "key",
                "project",
                "delegation"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "cancel_development"
                },
                "taskId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "operation",
                "taskId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "resume_development"
                },
                "taskId": {
                  "type": "string",
                  "minLength": 1
                },
                "delegation": {
                  "description": "Exact CURRENT user instruction to continue this existing task on the same checkout, including adopting a reviewed changed requirement.",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "operation",
                "taskId",
                "delegation"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "apply_development"
                },
                "taskId": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewedFingerprint": {
                  "description": "Copy from a fresh work_result with phase=ready and matchesReviewed=true. Never invent or reuse a different task's fingerprint.",
                  "type": "string",
                  "minLength": 1
                },
                "delegation": {
                  "description": "Exact CURRENT user instruction to apply this reviewed patch to the registered repository. Does not authorize commit, push or deployment.",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "operation",
                "taskId",
                "reviewedFingerprint",
                "delegation"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "enum": [
                    "follow_action",
                    "unfollow_action"
                  ]
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "actionId": {
                  "type": "string",
                  "minLength": 1
                },
                "expectedRevision": {
                  "description": "Current requirement revision from work_status.",
                  "type": "string",
                  "minLength": 1
                },
                "delegation": {
                  "description": "Exact CURRENT user instruction to add or stop following this requirement action in personal todos.",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "operation",
                "key",
                "actionId",
                "expectedRevision",
                "delegation"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^cite_[1-9]\\d*$"
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string"
          },
          "startLine": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "endLine": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "key",
          "startLine",
          "endLine"
        ],
        "additionalProperties": false
      }
    },
    "create_task": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "detail": {
              "type": "string"
            },
            "citation_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "due_at": {
              "description": "Actual completion deadline explicitly requested by the owner, with timezone. A reminder/check-in time belongs in follow_up.next_check_at. Null when only a reminder is requested; do not inherit a project's deadline for a new reminder.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "due_expression": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "follow_up": {
              "description": "Reminder/check-in scheduling, including a NEW reminder with no waiting party. Set next_check_at and the owner's exact time_expression; waiting_on=null unless waiting for someone, snoozed_until=null for an initial reminder. Separate from a completion deadline.",
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "waiting_on": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "next_check_at": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "snoozed_until": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "time_expression": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 500
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "timezone": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "required": [
                    "waiting_on",
                    "next_check_at",
                    "snoozed_until",
                    "time_expression",
                    "timezone"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "title",
            "detail",
            "citation_ids",
            "due_at",
            "due_expression",
            "follow_up"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "update_task": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "expected_version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "action": {
              "type": "string",
              "enum": [
                "complete",
                "reopen",
                "reschedule",
                "wait",
                "snooze",
                "cancel"
              ]
            },
            "due_at": {
              "description": "Actual completion deadline explicitly requested by the owner, with timezone. A reminder/check-in time belongs in follow_up.next_check_at. Null when only a reminder is requested; do not inherit a project's deadline for a new reminder.",
              "anyOf": [
                {
                  "type": "string"
