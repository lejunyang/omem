{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "documents": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "topicPath": {
            "description": "Human topic hierarchy, broad to specific. Organize by the subject and reader purpose, not source directories or internal ids.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "sections": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,59}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24000
                }
              },
              "required": [
                "key",
                "title",
                "body"
              ],
              "additionalProperties": false
            }
          },
          "citations": {
            "minItems": 1,
            "maxItems": 160,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,39}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 800
                },
                "relation": {
                  "type": "string",
                  "enum": [
                    "supports",
                    "explains",
                    "implements",
                    "depends_on",
                    "calls",
                    "contradicts",
                    "background",
                    "tracks"
                  ]
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "material",
                        "article"
                      ]
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "startLine": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "section": {
                      "type": "string",
                      "maxLength": 100
                    }
                  },
                  "required": [
                    "kind",
                    "key"
                  ],
                  "additionalProperties": false
                },
                "quote": {
                  "description": "Leave empty. The host extracts the exact quote from the selected fixed line range before independent review.",
                  "default": "",
                  "type": "string",
                  "maxLength": 120000
                }
              },
              "required": [
                "key",
                "label",
                "reason",
                "relation",
                "target",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "questions": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "why": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "nextStep": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "blocking": {
                  "type": "boolean"
                },
                "citationKeys": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "question",
                "why",
                "nextStep",
                "blocking",
                "citationKeys"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "key",
          "title",
          "summary",
          "category",
          "sections",
          "citations",
          "questions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "documents"
  ],
  "additionalProperties": false,
  "$id": "https://omem.invalid/contracts/KnowledgeBatch.v1"
}
