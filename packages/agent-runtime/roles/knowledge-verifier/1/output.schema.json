{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "verdicts": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "documentKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "verdict": {
            "type": "string",
            "enum": [
              "accepted",
              "needs_revision"
            ]
          },
          "issues": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600
            }
          },
          "suggestions": {
            "description": "Nonblocking wording, formatting or optional detail suggestions. Do not reject or require whole-page regeneration for these.",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600
            }
          },
          "questions": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "description": "investigate: agent must search/read actual state; supplement: useful nonblocking detail; decision: a real owner choice affecting present scope, responsibility or permission. Only decision may be blocking. Missing legacy classification is investigate, never an automatic request for owner approval.",
                  "type": "string",
                  "enum": [
                    "investigate",
                    "supplement",
                    "decision"
                  ]
                },
                "question": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "why": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "nextStep": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "blocking": {
                  "type": "boolean"
                },
                "citationKeys": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "question",
                "why",
                "nextStep",
                "blocking",
                "citationKeys"
              ],
              "additionalProperties": false
            }
          },
          "rangeRepair": {
            "description": "Only after full review: remaining blocking issues are exact line ranges of existing material citations or reviewSources. Keep prose, sources, reasons and relations unchanged. Identify background dependencies by sectionKey, key and previousStartLine/previousEndLine. Unknown ranges or substantive changes require normal revision.",
            "type": "object",
            "properties": {
              "citations": {
                "minItems": 0,
                "maxItems": 160,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,39}$"
                    },
                    "startLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "key",
                    "startLine",
                    "endLine"
                  ],
                  "additionalProperties": false
                }
              },
              "reviewSources": {
                "type": "array",
                "maxItems": 160,
                "items": {
                  "type": "object",
                  "properties": {
                    "sectionKey": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,59}$"
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "previousStartLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "previousEndLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "startLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "sectionKey",
                    "key",
                    "previousStartLine",
                    "previousEndLine",
                    "startLine",
                    "endLine"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "citations"
                ],
                "properties": {
                  "citations": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "reviewSources"
                ],
                "properties": {
                  "reviewSources": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        },
        "required": [
          "documentKey",
          "verdict",
          "issues",
          "questions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "verdicts"
  ],
  "additionalProperties": false,
  "$id": "https://omem.invalid/contracts/KnowledgeReview.v1"
}
