{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "verdicts": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "documentKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "verdict": {
            "type": "string",
            "enum": [
              "accepted",
              "needs_revision"
            ]
          },
          "issues": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600
            }
          },
          "suggestions": {
            "description": "Nonblocking wording, formatting or optional detail suggestions. Do not reject or require whole-page regeneration for these.",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600
            }
          },
          "questions": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "description": "investigate: agent must search/read actual state; supplement: useful nonblocking detail; decision: a real owner choice affecting present scope, responsibility or permission. Only decision may be blocking. Missing legacy classification is investigate, never an automatic request for owner approval.",
                  "type": "string",
                  "enum": [
                    "investigate",
                    "supplement",
                    "decision"
                  ]
                },
                "question": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "why": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "nextStep": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "blocking": {
                  "type": "boolean"
                },
                "citationKeys": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "question",
                "why",
                "nextStep",
                "blocking",
                "citationKeys"
              ],
              "additionalProperties": false
            }
          },
          "rangeRepair": {
            "description": "Only for needs_revision after completing full review: all other facts, premises and reader goals passed, and every blocking issue is solely an existing material citation's line range. Provide exact replacement ranges. Omit when ranges are unknown or prose, citation relations, new citations or reviewSources need changes. During citation_ranges review, preserve the host-supplied full-review baseline; revoke range repair if a substantive issue is discovered.",
            "type": "object",
            "properties": {
              "citations": {
                "minItems": 1,
                "maxItems": 160,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,39}$"
                    },
                    "startLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "key",
                    "startLine",
                    "endLine"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "citations"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "documentKey",
          "verdict",
          "issues",
          "questions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "verdicts"
  ],
  "additionalProperties": false,
  "$id": "https://omem.invalid/contracts/KnowledgeReview.v1"
}
