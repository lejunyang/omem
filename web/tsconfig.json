{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "@omem/plugin-sdk": ["../packages/plugin-sdk/client.ts"], "@omem/plugin-sdk/blocks": ["../packages/plugin-sdk/blocks.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../packages/plugin-sdk/*.ts", "../plugins/*/web/**/*.ts", "../plugins/*/web/**/*.vue"]
}
