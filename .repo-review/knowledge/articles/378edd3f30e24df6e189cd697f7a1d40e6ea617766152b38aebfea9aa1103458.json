        "quote": "  \"checks\": [\n    \"empty real workspace and material capture\",\n    \"A-U01 real job, applied proposal, notification and evidence flow\",\n    \"recursive evidence, cycle and return focus\",\n    \"version update and immutable prior revision\",\n    \"task creation and persistent change notifications\",\n    \"A-U02 decision diff, evidence, receipts and stale state\",\n    \"A-U03 QR, direct authorization link, reusable app and pairing\",\n    \"page reload and desktop rendering\",\n    \"A-U04 768px layout and keyboard focus\",\n    \"390px mobile viewport and full-screen dialog\",\n    \"100 persisted evidence nodes and bounded current rendering\",\n    \"A-U05 offline, model, delivery failure and restart truthfulness\""
      },
