        "quote": "      const capture = this.store.capture(\n        {\n          source: \"manual\",\n          externalId: `message-feedback:${value.requestId}`,\n          title: `${row.chat_name}：我的纠正`,\n          parts: [\n            {\n              type: \"text\",\n              text: `针对消息：\\n${original.fragments.map((f) => f.text).join(\"\\n"
      },
      {
        "key": "c5",
        "label": "撤销与手动重试",
        "reason": "支持软撤销、撤销后重新处理，以及按消息 revision 手动重试的条件与行为。",
        "relation": "implements",
        "target": {
