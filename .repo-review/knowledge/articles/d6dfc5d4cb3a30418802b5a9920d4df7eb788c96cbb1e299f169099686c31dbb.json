          "key": "omem:apps/server/src/messages/feedback.ts",
          "startLine": 119,
          "endLine": 141
        },
        "quote": "  revoke(id: string) {\n    return this.store.tx(() => {\n      const row = this.store.db\n        .prepare(\"SELECT * FROM message_feedback WHERE id=? AND active=1\")\n        .get(id);\n      if (!row) throw Error(\"这条纠正已撤销或不存在\");\n      this.store.db\n        .prepare(\"UPDATE message_feedback SET active=0 WHERE id=?\")\n       "
      },
      {
        "key": "c6",
        "label": "重新提取作业",
        "reason": "支持重新处理读取 source head 和 validity epoch，并以 owner_correction 原因排入 extract_claims 作业。",
        "relation": "implements",
        "target": {
          "kind": "material",
          "key": "omem:apps/server/src/messages/feedback.ts",
          "startLine": 142,
          "endLine": 162
        },
        "quote": "  private reconsider(sourceId: string, feedbackId: string) {\n    const source = this.store.db\n      .prepare(\"SELECT head FROM sources WHERE id=?\")\n      .get(sourceId)!;\n    const state = this.store.db\n      .prepare(\"SELECT validity_epoch FROM source_state WHERE source_id=?\")\n      .get(sourceId)!;\n    return this.st"
      }
