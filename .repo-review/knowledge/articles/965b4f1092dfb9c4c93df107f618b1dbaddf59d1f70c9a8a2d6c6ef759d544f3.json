      },
      {
        "key": "c2",
        "label": "固定 Git revision 与相对路径限制",
        "reason": "支持读取 HEAD 已提交内容、返回提交标识，并准确说明被拒绝的是越界相对文件参数。",
        "relation": "supports",
        "target": {
          "kind": "material",
          "key": "omem:apps/server/tests/connectors.test.ts",
          "startLine": 32,
          "endLine": 58
        },
