          "endLine": 21
        },
        "quote": "<template>\n  <button\n    :type=\"type\"\n    class=\"om-button\"\n    :class=\"variant\"\n    :disabled=\"disabled || loading\"\n    :aria-busy=\"loading\"\n  >\n    <span v-if=\"loading\" aria-hidden=\"true\">◌</span><slot />\n  </button>"
      },
