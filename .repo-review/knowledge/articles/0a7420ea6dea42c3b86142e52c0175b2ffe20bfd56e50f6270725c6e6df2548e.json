          "endLine": 157
        },
        "quote": "export type ProposalEvidence = {\n  fragment_revision_id: string;\n  source_revision_id: string;\n  exact_quote?: string;\n  asset_hash?: string;\n};\nexport type Proposal = {\n  id: string;\n  kind: \"task\" | \"claim\" | \"episode\" | \"procedure\";\n  operation: \"create\" | \"update\" | \"supersede\";\n  targetId: string | null;\n  body: R"
      },
      {
        "key": "c3",
        "label": "通用请求封装",
        "reason": "说明令牌来源、默认方法、JSON 编解码和错误处理流程及其限制。",
        "relation": "implements",
        "target": {
          "kind": "material",
          "key": "omem:apps/web/src/api.ts",
          "startLine": 240,
          "endLine": 257
        },
        "quote": "export function headers(): Record<string, string> {\n  const token = sessionStorage.getItem(\"omem-token\");\n  return token ? { Authorization: \"Bearer \" + token } : {};\n}\nexport async function api<T>(\n  path: string,\n  body?: unknown,\n  method = body === undefined ? \"GET\" : \"POST\",\n): Promise<T> {\n  const r = await fetch("
      },
      {
        "key": "c4",
        "label": "评审 API 的认证边界",
        "reason": "证明 repo-review 客户端与个人工作区 API 的认证策略不同。",
        "relation": "depends_on",
        "target": {
          "kind": "material",
          "key": "omem:apps/web/src/review-api.ts",
          "startLine": 1,
          "endLine": 4
        },
        "quote": "/** Client for the repo-review knowledge-base API (/api/review/*). This surface is\n * read/browse/sync only, bound to loopback, and has no token gating, so unlike the\n * personal workspace api.ts it sends no Authorization header. Shapes mirror\n * apps/server/src/review/app.ts exactly. */"
      }
    ],
    "questions": [
      {
        "question": "服务端是否保证所有 `/api` 响应（包括错误和无内容响应）都包含合法 JSON？",
        "why": "当前实现无条件调用 `r.json()`；若服务端返回 204 或代理生成 HTML 错误页，实际异常会掩盖服务端状态与通用错误信息。",
        "nextStep": "核对服务端路由的响应约定，并补充空响应、非 JSON 错误及网络失败的行为测试；若不能保证，再决定是否增强解析分支。",
        "blocking": false,
        "citationKeys": [
          "c3"
        ]
      }
    ]
  },
