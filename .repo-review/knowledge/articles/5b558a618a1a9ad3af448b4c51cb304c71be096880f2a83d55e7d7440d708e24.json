          "startLine": 37,
          "endLine": 47
        },
        "quote": "  private async wait(promise:Promise<ResearchSnapshot>,signal?:AbortSignal) {\n    if (!signal) return promise;\n    let abort!:()=>void;\n    const cancellation = new Promise<never>((_resolve,reject)=>{\n      abort=()=>reject(signal.reason);\n      signal.addEventListener(\"abort\",abort,{once:true});\n      if(signal.aborte"
      },
      {
        "key": "c6",
        "label": "关闭与资源清理",
        "reason": "支持关闭标志、会话级构建中止和临时目录删除行为。",
        "relation": "implements",
        "target": {
          "kind": "material",
          "key": "omem:apps/server/src/knowledge/research-session.ts",
          "startLine": 48,
          "endLine": 52
        },
        "quote": "  close() {\n    this.closed = true;\n    this.controller.abort(Error(\"Research session has ended\"));\n    if (this.root) rmSync(this.root,{recursive:true,force:true});\n  }"
      }
