        "quote": "  async snapshot(materials: KnowledgeMaterial[], articles: KnowledgeArticle[], signal?: AbortSignal) {\n    if (this.closed) throw Error(\"Research session has ended\");\n    signal?.throwIfAborted();\n    const identity = stableDigest({materials: materials.map(m=>[m.key,m.revisionId,m.digest]).sort(), articles: articles.ma"
      },
      {
        "key": "c4",
        "label": "共享快照构建",
        "reason": "支持临时 SQLite 路径、构建器参数、会话级取消信号和 ResearchSnapshot 返回结构。",
        "relation": "calls",
        "target": {
          "kind": "material",
          "key": "omem:apps/server/src/knowledge/research-session.ts",
          "startLine": 28,
          "endLine": 35
        },
        "quote": "    this.root = mkdtempSync(join(tmpdir(), \"omem-knowledge-session-\"));\n    const file = join(this.root, \"snapshot.sqlite\");\n    this.identity = identity;\n    this.building = buildResearchSnapshot({repository:this.repository,materials,articles,file,includeUnanchoredState:true,signal:this.controller.signal}).then(timing"
      },
      {
        "key": "c5",
        "label": "单次等待的取消处理",
        "reason": "支持 wait 对调用方信号与共享 Promise 的竞速，以及事件监听器清理行为。",
        "relation": "implements",
