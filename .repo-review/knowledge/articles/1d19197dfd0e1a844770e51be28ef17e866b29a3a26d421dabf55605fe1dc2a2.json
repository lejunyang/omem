        "quote": "        <small\n          >有效至\n          {{ new Date(decision.expiresAt).toLocaleString(\"zh-CN\") }}</small\n        >\n        <small v-if=\"decision.requestId\" class=\"receipt-id\"\n          >处理回执 {{ decision.requestId }}</small\n        >\n      </div>\n      <p>{{ decision.proposal.reason }}</p>\n      <details open>\n        "
      },
      {
        "key": "c3",
        "label": "决策提交函数",
        "reason": "支持三类动作及 proposalDigest、requestId、actorId 的提交和成功、失败刷新流程。",
        "relation": "implements",
        "target": {
          "kind": "material",
          "key": "omem:apps/web/src/DecisionsView.vue",
          "startLine": 28,
          "endLine": 55
        },
        "quote": "async function decide(\n  decision: Decision,\n  action: \"approve\" | \"reject\" | \"request_context\",\n) {\n  busy.value = decision.id + action;\n  try {\n    await api(`/decisions/${decision.id}`, {\n      action,\n      proposalDigest: decision.proposalDigest,\n      requestId: crypto.randomUUID(),\n      actorId: decision.actorI"
      },
      {
        "key": "c4",
        "label": "证据入口与操作限制",
        "reason": "支持证据跳转、失效提示、仅待处理状态可操作及空列表语义。",
        "relation": "explains",
        "target": {
          "kind": "material",
          "key": "omem:apps/web/src/DecisionsView.vue",
          "startLine": 112,
          "endLine": 146
        },
        "quote": "      <div class=\"evidence-list\">\n        <OmCitation\n          v-for=\"(item, index) in decision.proposal.evidence\"\n          :key=\"item.fragment_revision_id\"\n          :label=\"`依据 ${index + 1}${item.exact_quote ? `：${item.exact_quote.slice(0, 36)}` : ''}`\"\n          @open=\"emit('open', item.fragment_revision_id)\"\n    "
      }
    ],
    "questions": [
      {
        "question": "服务端是否强制校验 proposalDigest、actorId、requestId 与过期状态，而不只依赖前端隐藏按钮？",
        "why": "材料只能确认这些字段被提交以及 stale 状态在界面上不可操作，无法证明服务端的并发、防重放和授权规则。",
        "nextStep": "检查决策端点实现及其并发、过期、重复请求测试，确认旧摘要或伪造执行者会被拒绝。",
