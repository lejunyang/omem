          "startLine": 5,
          "endLine": 16
        },
        "quote": "import { Store } from \"../apps/server/src/store.js\";\nimport { loadChineseEmbedding } from \"../apps/server/src/retrieval/embedding.js\";\nimport { SemanticRetrieval } from \"../apps/server/src/retrieval/semantic.js\";\nimport { captureSchema } from \"../packages/contracts/src/index.js\";\nconst dir = mkdtempSync(join(tmpdir(),\""
      },
      {
        "key": "c2",
        "label": "批量索引与 Top-1 断言",
        "reason": "支持捕获后追平索引，并要求每个异步查询首项为预期 fragment 且包含 semantic 路线。",
        "relation": "supports",
        "target": {
          "kind": "material",
          "key": "omem:scripts/live-retrieval-smoke.ts",
          "startLine": 17,
          "endLine": 29
        },
        "quote": "const ids: string[] = [];\ntry {\n  for (const c of cases) ids.push(store.capture(captureSchema.parse({ source: \"manual\", title: c.title, externalId: c.title, parts: [{ type: \"text\", text: c.text }] })).revision.fragments[0]!.id);\n  while (await retrieval.indexBatch()) {}\n  const results = [];\n  for (let i = 0; i < cases"
      },
      {
        "key": "c3",
        "label": "可见性过滤与健康报告",
        "reason": "支持排除指定 fragment、输出健康和案例报告以及清理临时资源。",
        "relation": "supports",
        "target": {
          "kind": "material",
          "key": "omem:scripts/live-retrieval-smoke.ts",
          "startLine": 30,
          "endLine": 35
        },
        "quote": "  const excluded = await retrieval.searchSourcesAsync({ text: cases[0]!.query, visible: id => id !== ids[0] });\n  assert.ok(excluded.every(h => h.fragmentId !== ids[0]));\n  const report = { passed: true, health: retrieval.health(), cases: results };\n  mkdirSync(resolve(\".omem/verification\"),{recursive:true}); writeFile"
      }
    ],
    "questions": [
      {
        "question": "该现场测试使用的 embedding 向量身份和锁定模型版本是什么，报告能否发现旧索引混用？",
        "why": "材料只显示调用 loadChineseEmbedding 和输出 health，未展示报告字段是否包含模型标识、维度或索引版本。",
        "nextStep": "检查 SemanticRetrieval.health 与 embedding 配置合同，并增加模型身份变化后拒绝复用旧向量的现场断言。",
        "blocking": false,
        "citationKeys": [
