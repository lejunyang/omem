        "quote": "    \"confidence\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 1 },\n    \"model\": { \"type\": [\"string\", \"null\"] },\n    \"prompt_digest\": { \"type\": \"string\", \"pattern\": \"^[a-f0-9]{64}$\" },\n    \"schema_digest\": { \"type\": \"string\", \"pattern\": \"^[a-f0-9]{64}$\" },\n    \"input_digest\": { \"type\": \"string\", \"pattern\": \"^[a-f0-9]{6"
      },
      {
        "key": "c6",
        "label": "生成与验证字段",
        "reason": "支持生成时间、种子标志及验证者字段的基础类型说明。",
        "relation": "supports",
        "target": {
