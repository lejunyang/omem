        "quote": "/** Eval-only opt-in discriminator. Normal import paths never (and must never)\n *  pass this literal; it exists so an accidental production call fails loudly. */\nexport const QUALITY_EVAL_ONLY = \"EVAL_ONLY_RESEARCH\" as const;"
