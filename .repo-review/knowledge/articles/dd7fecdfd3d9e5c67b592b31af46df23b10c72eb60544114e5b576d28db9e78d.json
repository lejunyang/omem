          "startLine": 36,
          "endLine": 46
        },
        "quote": "  const recalled = await turn(\"之前记录的熔断器连续失败几次会打开，冷却多久？\");\n  assert.ok(JSON.stringify(recalled.turn.selectedEvidence).includes(revision.fragments[0]!.id), \"Must cite original English source\");\n  assert.match(recalled.turn.result, /7|七|seven/i); assert.match(recalled.turn.result, /41|四十一/);\n  await turn(\"帮我记一下：2030年10月2日"
      },
      {
        "key": "c4",
        "label": "现场报告与清理",
