          "startLine": 5,
          "endLine": 9
        },
        "quote": "<template>\n  <button class=\"om-citation\" @click=\"$emit('open')\">\n    {{ label }}<sup>{{ version ? \"v\" + version : \"↗\" }}</sup>\n  </button>\n</template>"
      },
      {
