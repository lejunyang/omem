        "quote": "<script setup lang=\"ts\">\ndefineProps<{ label: string; version?: number }>();\ndefineEmits<{ open: [] }>();\n</script>\n<template>\n  <button class=\"om-citation\" @click=\"$emit('open')\">\n    {{ label }}<sup>{{ version ? \"v\" + version : \"↗\" }}</sup>\n  </button>"
