    "questions": [
      {
        "question": "Proposal v1 何时从 draft 固化为受版本兼容承诺保护的正式合同？",
        "why": "Schema 标题仍标为 draft，但计划要求前后端合同由统一 contracts 包提供；若生产数据已经持久化，后续收紧字段会涉及迁移与兼容策略。",
        "nextStep": "确认当前运行时采用的 Schema 来源，记录已落库版本，并定义 draft 到正式 v1 的兼容、迁移和弃用规则。",
        "blocking": false,
        "citationKeys": [
          "c1",
          "c4"
        ]
      },
      {
        "question": "文本 selector 是否需要在 Schema 层直接约束 end 大于 start？",
        "why": "当前仅分别限制 start≥0、end≥1，无法仅靠该 Schema 排除倒置或空区间，实际正确性依赖额外验证器。",
        "nextStep": "明确该不变量由应用验证还是自定义 Schema 关键字承担，并加入 start=end、end<start 及 Unicode 多码点测试。",
        "blocking": false,
        "citationKeys": [
          "c2"
        ]
      },
      {
        "question": "Proposal v1 何时从 draft 固化为受兼容承诺保护的正式合同？",
        "why": "Schema 标题仍为 draft；如果该结构已用于持久化数据，后续字段收紧会涉及兼容和迁移。",
        "nextStep": "确认运行时采用的 Schema 来源及已落库版本，并定义 draft 到正式 v1 的迁移、兼容和弃用规则。",
        "blocking": false,
        "citationKeys": [
          "c1",
          "c4"
        ]
      },
      {
        "question": "文本 selector 的 end > start 不变量由哪一层验证？",
        "why": "当前 Schema 只分别约束 start≥0、end≥1，不能排除空区间或倒置区间。",
        "nextStep": "明确由应用验证器还是扩展 Schema 约束该不变量，并覆盖 start=end、end<start 和 Unicode 多码点测试。",
        "blocking": false,
        "citationKeys": [
          "c2"
        ]
      }
    ]
