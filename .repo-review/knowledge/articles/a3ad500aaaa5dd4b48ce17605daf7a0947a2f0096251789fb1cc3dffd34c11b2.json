        },
        "quote": "  \"skill_bundles\": [\n    {\n      \"canonical_name\": \"omem-evidence-review\",\n      \"version\": \"review-1\",\n      \"load_mode\": \"inline\",\n      \"artifact_digest\": \"1d26700ca953439e4bd2a36147da942f1cce7802c7fbfa736d5fde4861abeb55\"\n    }\n  ],"
      },
