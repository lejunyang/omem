          "startLine": 2,
          "endLine": 5
        },
        "quote": "import { OmTrailDrawer, useEvidenceTrail } from \"@omem/ui\";\nimport KnowledgeHome from \"./KnowledgeHome.vue\";\nimport KnowledgeFrame from \"./KnowledgeFrame.vue\";\nconst { frames, current, open, loopAt, trigger, active, push, back, jump, close } = useEvidenceTrail();"
      },
      {
        "key": "c4",
        "label": "抽屉事件与活动帧接线",
        "reason": "支持抽屉属性、焦点目标配置、事件处理及 loaded 事件载荷写入活动帧标题的说明。",
        "relation": "explains",
        "target": {
          "kind": "material",
          "key": "omem:apps/web/src/knowledge/PersonalKnowledge.vue",
          "startLine": 9,
          "endLine": 10
        },
        "quote": "  <OmTrailDrawer :open=\"open\" :frames=\"frames\" :current=\"current\" :loop-at=\"loopAt\" :return-focus-to=\"trigger\" @close=\"close\" @back=\"back\" @jump=\"jump\" @dismiss-loop=\"loopAt = null\">\n    <KnowledgeFrame v-if=\"active\" :frame=\"active\" prefix=\"/api/knowledge\" @navigate=\"push\" @loaded=\"active.title = $event\" />"
      }
    ],
