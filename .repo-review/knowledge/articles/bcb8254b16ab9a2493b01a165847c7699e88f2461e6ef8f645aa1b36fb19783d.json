        "quote": "  \"skill_bundles\": [\n    {\n      \"canonical_name\": \"omem-extract\",\n      \"version\": \"extract-1\",\n      \"load_mode\": \"inline\",\n      \"artifact_digest\": \"75f0112122d4103309c3d693dceeb1a19bd992abe4b91756e9a893a9b36ee644\"\n    }\n  ],"
      },
      {
        "key": "c4",
        "label": "工具与会话隔离策略",
        "reason": "支持附近关于禁用工具、禁止复用会话及不继承用户扩展能力的说明。",
        "relation": "supports",
