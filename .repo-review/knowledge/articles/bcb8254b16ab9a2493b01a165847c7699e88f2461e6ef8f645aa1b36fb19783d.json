        "quote": "  \"schema_version\": 1,\n  \"role_id\": \"extractor\",\n  \"role_version\": \"1\",\n  \"profile_ref\": \"traex\",\n  \"prompt_templates\": [\n    \"prompt.md\"\n  ],"
      },
      {
        "key": "c2",
