          "startLine": 1,
          "endLine": 5
        },
        "quote": "<script setup lang=\"ts\">\nwithDefaults(\n  defineProps<{ tone?: \"neutral\" | \"warning\" | \"danger\" | \"success\" }>(),\n  { tone: \"neutral\" },\n);"
      },
      {
        "key": "c2",
        "label": "徽标模板结构",
        "reason": "支持固定基础类、动态色调类和默认插槽共同构成渲染结构的说明。",
        "relation": "implements",
        "target": {
          "kind": "material",
          "key": "omem:packages/ui/src/components/OmBadge.vue",
          "startLine": 7,
          "endLine": 9
        },
        "quote": "<template>\n  <span class=\"om-badge\" :class=\"tone\"><slot /></span>\n</template>"
      },
      {
        "key": "c3",
        "label": "徽标基础样式",
        "reason": "支持行内布局、尺寸规则、主题变量依赖以及内容不换行边界的说明。",
        "relation": "explains",
        "target": {
          "kind": "material",
          "key": "omem:packages/ui/src/components/OmBadge.vue",
          "startLine": 10,
          "endLine": 20
        },
        "quote": "<style scoped>\n.om-badge {\n  display: inline-flex;\n  align-items: center;\n  border: 1px solid var(--om-line);\n  padding: 2px 8px;\n  border-radius: 5px;\n  font-size: 12px;\n  color: var(--om-secondary);\n  white-space: nowrap;\n}"
      },
      {
        "key": "c4",
        "label": "三种专用色调样式",
        "reason": "支持 warning、danger、success 具有专用颜色规则，而 neutral 仅沿用基础样式的结论。",
        "relation": "explains",
        "target": {
