          "startLine": 29,
          "endLine": 103
        },
        "quote": "const registrationPath = \"/oauth/v1/app/registration\";\nconst retryMarker = \"__omemRegistrationRetry\";\nlet registrationRetryInstalled = false;\n\n/** Keep the same RFC 8628 device_code alive across transient poll failures.\n * The upstream SDK treats one network error as terminal; retrying its Axios\n * request here preserv"
      },
      {
        "key": "c2",
        "label": "OpenAPI 能力探测",
        "reason": "支持 token 获取、应用与机器人信息查询、缺失权限比较，以及事件订阅只能由运行时投递验证的边界。",
        "relation": "explains",
        "target": {
          "kind": "material",
          "key": "omem:apps/server/src/integrations/lark/registration.ts",
          "startLine": 135,
          "endLine": 221
        },
        "quote": "/** Public OpenAPI capability probe. Event subscriptions are confirmed by the\n * first matching WebSocket delivery (pairing requires im.message.receive_v1),\n * because the public application endpoint does not expose the event list. */\nexport class OfficialLarkCapabilityProbe implements LarkCapabilityProbe {\n  construct"
      },
      {
        "key": "c3",
        "label": "未配置探针时拒绝激活",
        "reason": "支持缺少真实能力探针时返回封闭失败结果，而非信任请求配置。",
        "relation": "supports",
        "target": {
          "kind": "material",
          "key": "omem:apps/server/src/integrations/lark/registration.ts",
          "startLine": 225,
          "endLine": 242
        },
        "quote": "export interface LarkCapabilityProbe {\n  probe(\n    credentials: { appId: string; clientSecret: string },\n    requested: LarkRequestedConfig,\n  ): Promise<LarkCapabilityResult>;\n}\n\n/** Live capability checks depend on tenant/admin state and are wired by B2-05 callers.\n * Refuse activation when no real probe is configur"
      },
      {
        "key": "c4",
        "label": "实时路由读取机器人身份",
        "reason": "说明实时消息处理会读取 capability profile 中的 botOpenId，但该片段本身不能证明探测结果如何写入该字段。",
        "relation": "depends_on",
        "target": {
          "kind": "material",
          "key": "omem:apps/server/src/integrations/lark/realtime.ts",
          "startLine": 503,
          "endLine": 522
        },
        "quote": "    const connection = this.store.db\n      .prepare(\n        `SELECT c.id,v.capability_profile,b.id AS binding_id,b.binding_version,b.owner_open_id AS binding_owner_open_id\n         FROM lark_connections c\n         JOIN lark_connection_versions v ON v.connection_id=c.id\n           AND v.version=c.active_version\n       "
      }
    ],
    "questions": [
      {
        "question": "国际版 Lark 租户的能力探测是否也应切换到对应开放平台域名？",
        "why": "注册结果可以携带 tenantBrand，但当前能力探测把基地址固定为 open.feishu.cn；材料未展示国际版场景是否会注入其他 request 实现或由调用方切换域名。",
        "nextStep": "检查能力探针的构造与调用路径，并增加 Feishu、Lark 两类租户的端点断言。",
        "blocking": false,
        "citationKeys": [
          "c2"
        ]
      },
      {
        "question": "能力探测得到的 botOpenId 是否确定写入实时连接读取的 capability_profile？",
        "why": "探针会返回 botOpenId，实时路由也会读取该字段，但当前材料没有展示 onboarding 或连接版本持久化如何把前者写入后者。",
        "nextStep": "补充 onboarding 或连接版本写入实现的固定材料与引用；若不存在该链路，则继续把两者视为尚未确认接通。",
        "blocking": false,
        "citationKeys": [
          "c2",
          "c4"
        ]
      }
    ]
