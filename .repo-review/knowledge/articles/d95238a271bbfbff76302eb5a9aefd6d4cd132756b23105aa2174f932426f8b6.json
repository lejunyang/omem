      },
      {
        "key": "c4",
        "label": "片段入口与符号信息",
        "reason": "证明关联片段按钮以及路径、种类、范围、签名和源码切片的展示。",
        "relation": "implements",
        "target": {
          "kind": "material",
          "key": "omem:apps/web/src/codewiki/SymbolFrame.vue",
          "startLine": 147,
          "endLine": 164
        },
        "quote": "    <template v-else-if=\"symbol && file\">\n      <small class=\"muted\">{{ file.path }}</small>\n      <div class=\"head\">\n        <h3>{{ symbol.name }}</h3>\n        <div class=\"row\">\n          <OmBadge>{{ symbol.kind }}</OmBadge>\n          <OmBadge>L{{ symbol.rangeStart?.line }}-{{ symbol.rangeEnd?.line }}</OmBadge>\n      "
      },
      {
        "key": "c5",
        "label": "符号关系列表",
        "reason": "支持 60 条渲染上限、仅按可解析性禁用以及直接展示 edgeKind 的边界说明。",
        "relation": "implements",
        "target": {
          "kind": "material",
          "key": "omem:apps/web/src/codewiki/SymbolFrame.vue",
          "startLine": 165,
          "endLine": 179
        },
        "quote": "      <h4>符号边 <small>{{ myEdges.length }}</small></h4>\n      <p class=\"muted small\">调用 / 被调用 / 测试 / 规则双向可走；同文件符号也打开范围帧。</p>\n      <button\n        v-for=\"e in myEdges.slice(0, 60)\"\n        :key=\"e.edgeId\"\n        class=\"edge-row\"\n        :class=\"{ disabled: !edgeResolvable(e) }\"\n        :disabled=\"!edgeResolvable(e)\"\n  "
      }
