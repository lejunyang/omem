      },
      {
        "key": "c3",
        "label": "秘密读取与删除",
        "reason": "支持格式校验、认证解密及删除后的目录同步行为。",
        "relation": "implements",
        "target": {
          "kind": "material",
          "key": "omem:apps/server/src/integrations/lark/secret-store.ts",
          "startLine": 102,
          "endLine": 132
        },
        "quote": "  get(reference: string): SecretPayload {\n    const stored = JSON.parse(readFileSync(this.path(reference), \"utf8\")) as {\n      version: number;\n      algorithm: string;\n      iv: string;\n      tag: string;\n      ciphertext: string;\n    };\n    if (stored.version !== 1 || stored.algorithm !== \"aes-256-gcm\")\n      throw E"
      },
      {
        "key": "c4",
        "label": "配对码 HMAC",
        "reason": "支持配对码使用带领域分隔前缀的 HMAC-SHA256 生成摘要。",
        "relation": "explains",
        "target": {
          "kind": "material",
          "key": "omem:apps/server/src/integrations/lark/secret-store.ts",
          "startLine": 134,
          "endLine": 139
        },
        "quote": "  hashPairingCode(code: string) {\n    return createHmac(\"sha256\", this.key)\n      .update(\"omem-lark-pairing-v1\\0\")\n      .update(code)\n      .digest(\"hex\");\n  }"
      }
    ],
    "questions": [
      {
        "question": "主密钥轮换时，已有秘密文件如何继续解密或迁移？",
        "why": "文件格式含版本但没有 key ID，构造器也只接受单一密钥；直接更换环境密钥将使旧凭据无法读取。",
        "nextStep": "确认部署是否明确禁止原地轮换；若需要轮换，设计带 key ID 的格式和原子重加密流程。",
        "blocking": false,
        "citationKeys": [
          "c1",
          "c3"
        ]
      }
    ]
