        "quote": "  // Serial batches avoid competing CPU work and quadratic padding of long inputs.\n  let serial: Promise<unknown> = Promise.resolve();\n  return {\n    id:\n      supported.label +\n      \"-q8-pair512-temp3-v1:\" +\n      createHash(\"sha256\").update(hashes.join(\":\")).digest(\"hex\"),\n    score(query, passages) {\n      const wo"
