      },
      {
        "key": "c2",
        "label": "严格端口、代理与信号退出",
        "reason": "支持监听范围、strictPort、API 代理和优雅关闭行为的论断。",
        "relation": "supports",
        "target": {
          "kind": "material",
          "key": "omem:scripts/dev-review-vite.ts",
          "startLine": 22,
          "endLine": 40
        },
        "quote": "  server: {\n    host: \"127.0.0.1\",\n    port: webPort,\n    // Never silently fall back to another port: if 5181 (or the configured\n    // REVIEW_WEB_PORT) is busy, Vite exits non-zero and the orchestrator\n    // propagates that code instead of printing a URL we are not serving on.\n    strictPort: true,\n    proxy: { \"/ap"
      }
