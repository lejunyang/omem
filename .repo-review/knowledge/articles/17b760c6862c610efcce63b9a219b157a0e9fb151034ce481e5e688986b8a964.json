          "endLine": 4
        },
        "quote": "interface:\n  display_name: \"复核知识正文\"\n  short_description: \"Build linked knowledge from fixed evidence\"\n  default_prompt: \"Use $omem-knowledge-verifier to process the supplied fixed materials.\""
      },
      {
        "key": "c2",
        "label": "英文短描述",
        "reason": "支持短描述采用“构建关联知识”措辞并与复核职责存在语义差异的判断。",
        "relation": "contradicts",
        "target": {
          "kind": "material",
          "key": "omem:packages/agent-runtime/roles/knowledge-verifier/1/skills/omem-knowledge-verifier/agents/openai.yaml",
