          "key": "omem:apps/server/src/review/main.ts",
          "startLine": 45,
          "endLine": 51
        },
        "quote": "  for (const signal of [\"SIGINT\", \"SIGTERM\"] as const)\n    process.on(signal, () => {\n      void app.close().then(() => process.exit(0));\n    });\n} catch (error) {\n  store.close();\n  throw error;"
      }
