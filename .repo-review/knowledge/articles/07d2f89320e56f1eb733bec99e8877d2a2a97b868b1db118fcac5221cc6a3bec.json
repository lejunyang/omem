        "quote": "    \"role\": {\n      \"enum\": [\n        \"repo-profiler\",\n        \"module-architect\",\n        \"symbol-explainer\",\n        \"relation-verifier\"\n      ]\n    },\n    \"status\": {\n      \"enum\": [\"seed\", \"generated\", \"verified\", \"failed\", \"rejected\"]\n    },"
