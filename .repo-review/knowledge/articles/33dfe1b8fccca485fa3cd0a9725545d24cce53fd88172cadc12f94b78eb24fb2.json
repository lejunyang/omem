      },
      {
        "key": "c2",
        "label": "知识 API 请求封装",
        "reason": "支持令牌、JSON 请求头、响应解析和错误传播流程，并界定请求头合并限制。",
        "relation": "implements",
        "target": {
          "kind": "material",
          "key": "omem:apps/web/src/knowledge/api.ts",
          "startLine": 6,
          "endLine": 10
        },
