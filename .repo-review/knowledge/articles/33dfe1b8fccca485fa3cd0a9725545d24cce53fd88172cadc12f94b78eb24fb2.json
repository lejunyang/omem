      },
      {
        "key": "c3",
        "label": "知识帧构造函数",
        "reason": "支持知识帧把文章键、可选版本与章节 JSON 序列化进 id。",
        "relation": "implements",
        "target": {
          "kind": "material",
          "key": "omem:apps/web/src/knowledge/api.ts",
          "startLine": 12,
          "endLine": 12
        },
        "quote": "export const knowledgeFrame = (key: string, title: string, revision?: string, section?: string): KnowledgeFrame => ({ kind: \"knowledge\", id: JSON.stringify({ key, revision, section }), title });"
      }
    ],
    "questions": [
      {
        "question": "后端是否保证所有成功响应均为 JSON、所有失败响应的 error 字段均为可安全展示的字符串？",
        "why": "前端对成功响应无条件调用 response.json()，并把失败体中的 truthy error 值交给 Error；现有材料没有服务端响应合同。",
        "nextStep": "核对知识 API 路由的响应 schema 与错误处理中间件，并为非 JSON 成功体、空响应及非字符串 error 增加合同或行为测试。",
