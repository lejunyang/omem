        },
        "quote": "  \"skill_bundles\": [\n    {\n      \"canonical_name\": \"omem-knowledge-writer\",\n      \"version\": \"1\",\n      \"load_mode\": \"inline\",\n      \"artifact_digest\": \"58888347e8f2147676ff81c21288668678a0316157558968f960e1cec3915034\"\n    }\n  ],"
