          "endLine": 8
        },
        "quote": "  \"schema_version\": 1,\n  \"role_id\": \"knowledge-writer\",\n  \"role_version\": \"1\",\n  \"profile_ref\": \"traex\",\n  \"prompt_templates\": [\n    \"prompt.md\"\n  ],"
      },
      {
